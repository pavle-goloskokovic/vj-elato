e":"Video Game Consoles","year":"1990"},{"id":"CyberCaf","mp4":"CyberCaf.mp4","moov":1705647,"duration":1554,"title":"Cyber Cafes"},{"id":"CC506_buyers_guide","mp4":"CC506_buyers_guide.mp4","moov":1751594,"duration":1596,"title":"Buyer's Guide"},{"id":"VirtualM","mp4":"VirtualM.mp4","moov":1702928,"duration":1555,"title":"Virtual Meetings"},{"id":"JAVATool","mp4":"JAVATool.mp4","moov":1928493,"duration":1755,"title":"JAVA Tools"},{"id":"CarsComp","mp4":"CarsComp.mp4","moov":1777299,"duration":1616,"title":"Cars & Computers"},{"id":"CC704_new_laptops","mp4":"CC704_new_laptops.mp4","moov":1890667,"duration":1719,"title":"New Laptops"},{"id":"CC1238_interactive_music","mp4":"CC1238_interactive_music.mp4","moov":1763604,"duration":1608,"title":"Interactive Music"},{"id":"episode_937","mp4":"episode_937.mp4","moov":1784869,"duration":1627,"title":"Consumer Buying Guide"},{"id":"PCExpo","mp4":"PCExpo.mp4","moov":1703310,"duration":1552,"title":"PC Expo"},{"id":"Consumer_3","mp4":"Consumer_3.mp4","moov":1678745,"duration":1528,"title":"Consumers Buying Guide"},{"id":"episode_1136","mp4":"episode_1136.mp4","moov":1762803,"duration":1607,"title":"Consumer Buying Guide"},{"id":"IBMPerso1987","mp4":"IBMPerso1987.mp4","moov":1922720,"duration":1751,"title":"IBM Personal System/2","year":"1987"},{"id":"displays_2","mp4":"displays_2.mp4","moov":1907578,"duration":1739,"title":"Computer Displays"},{"id":"3DGraphi","mp4":"3DGraphi.mp4","moov":1815402,"duration":1653,"title":"3D Graphics"},{"id":"CC1320_winter_ces_1996","mp4":"CC1320_winter_ces_1996.mp4","moov":1799988,"duration":1637,"title":"Winter CES","year":"1996"},{"id":"CC1331_new_pcs","mp4":"CC1331_new_pcs.mp4","moov":1897537,"duration":1727,"title":"New PCs"},{"id":"MobileCo","mp4":"MobileCo.mp4","moov":1703768,"duration":1555,"title":"Mobile Computing"},{"id":"BestofCo","mp4":"BestofCo.mp4","moov":1818922,"duration":1657,"title":"Best of Comdex"},{"id":"CC1846CES2001","mp4":"CC1846CES2001.mp4","moov":1914952,"duration":1741,"title":"CES","year":"2001"},{"id":"Computer_6","mp4":"Computer_6.mp4","moov":1687700,"duration":1536,"title":"Consumer Buying Guide"},{"id":"CC1201_pc_expo","mp4":"CC1201_pc_expo.mp4","moov":1764816,"duration":1607,"title":"PC Expo"},{"id":"BuyingaN","mp4":"BuyingaN.mp4","moov":1687200,"duration":1535,"title":"Buying a New Computer"},{"id":"CC709_buyers_guide","mp4":"CC709_buyers_guide.mp4","moov":1853034,"duration":1686,"title":"Holiday Buyers Guide"},{"id":"CC1851ULTIMATE","mp4":"CC1851ULTIMATE.mp4","moov":1827142,"duration":1666,"title":"The Ultimate Gamer's PC"},{"id":"Creating_2","mp4":"Creating_2.mp4","moov":1793940,"duration":1636,"title":"Creativity Software"}],"bumps":[{"id":"cc-001","slides":[{"text":"stewart cheifet hosted this show for 19 years."},{"text":"he never once seemed bored."},{"text":"we've checked."},{"text":"computer chronicles."}]},{"id":"cc-002","slides":[{"text":"1989 was the year a floppy disk could hold a whole megabyte"},{"text":"and that was enough to get applause."},{"text":"computer chronicles."}]},{"id":"cc-003","slides":[{"text":"gary kildall co-hosted this show"},{"text":"and never mentioned that ibm chose someone else's operating system over his."},{"text":"not once."},{"text":"on camera."},{"text":"for seven years."},{"text":"computer chronicles."}]},{"id":"cc-004","slides":[{"text":"every guest on this show was confident their product would change everything."},{"text":"some of them were right."},{"text":"computer chronicles."}]},{"id":"cc-005","slides":[{"text":"128 kilobytes of ram."},{"text":"standing ovation."},{"text":"computer chronicles."}]},{"id":"cc-006","slides":[{"text":"a man in a tie is demonstrating a spreadsheet."},{"text":"the audience is riveted."},{"text":"they are not being sarcastic."},{"text":"computer chronicles."}]},{"id":"cc-007","slides":[{"text":"this show aired on pbs for 19 years and never ran out of things to be excited about."},{"text":"computer chronicles."}]},{"id":"cc-008","slides":[{"text":"the dot-com boom lasted about four years."},{"text":"this show covered every single one of them with a straight face."},{"text":"computer chronicles."}]},{"id":"cc-009","slides":[{"text":"in 1995 a man demonstrated the world wide web on this show"},{"text":"by loading a page in forty-five seconds"},{"text":"and calling it fast."},{"text":"computer chronicles."}]},{"id":"cc-010","slides":[{"text":"700 episodes."},{"text":"one set."},{"text":"computer chronicles."}]},{"id":"cc-011","slides":[{"text":"half the companies featured on this show no longer exist."},{"text":"the show outlasted all of them."},{"text":"computer chronicles."}]},{"id":"cc-012","slides":[{"text":"in 1984 someone walked onto a pbs set"},{"text":"carrying a hard drive that held ten megabytes,"},{"text":"weighed eleven pounds,"},{"text":"and cost more than a used car."},{"text":"everyone in the studio gathered around it"},{"text":"like it was a newborn."},{"text":"ten megabytes. the size of two mp3s."},{"text":"computer chronicles."}]},{"id":"cc-013","slides":[{"text":"they did an episode on the internet in 1993."},{"text":"the host had to explain what email was."},{"text":"the explanation took four minutes."},{"text":"it was thorough."},{"text":"it was patient."},{"text":"computer chronicles."}]},{"id":"cc-014","slides":[{"text":"every product demo on this show ends with the host nodding thoughtfully."},{"text":"stewart cheifet's thoughtful nod could sell anything."},{"text":"computer chronicles."}]},{"id":"cc-015","slides":[{"text":"the show's set had wood paneling."},{"text":"it kept the wood paneling for 19 years."},{"text":"respect."},{"text":"computer chronicles."}]},{"id":"cc-016","slides":[{"text":"pbs gave a tech show the same slot for 19 years."},{"text":"nobody at pbs has ever done anything that bold since."},{"text":"computer chronicles."}]},{"id":"cc-017","slides":[{"text":"the show started the same year as the macintosh."},{"text":"it ran longer than most of the products it covered."},{"text":"computer chronicles."}]},{"id":"cc-018","slides":[{"text":"gary kildall wrote cp/m,"},{"text":"the operating system that should have run every pc on earth."},{"text":"then he went flying the day ibm came calling."},{"text":"bill gates didn't go flying."},{"text":"kildall co-hosted this show for seven years after that."},{"text":"his co-host never brought it up."},{"text":"that's professionalism. that's also tragedy."},{"text":"computer chronicles."}]},{"id":"cc-019","slides":[{"text":"the tech industry reinvents itself every eighteen months."},{"text":"this show just kept the camera running."},{"text":"computer chronicles."}]},{"id":"cc-020","slides":[{"text":"someone demonstrated a pen-based computer in 1992."},{"text":"the stylus worked."},{"text":"the handwriting recognition didn't."},{"text":"the guest blamed the user's handwriting."},{"text":"it would take the industry twenty more years to figure this out."},{"text":"computer chronicles."}]},{"id":"cc-021","slides":[{"text":"they reviewed a modem once."},{"text":"2400 baud."},{"text":"the reviewer called it blazing."},{"text":"computer chronicles."}]},{"id":"cc-022","slides":[{"text":"the show never got cynical."},{"text":"the industry did."},{"text":"the show didn't."},{"text":"computer chronicles."}]},{"id":"cc-023","slides":[{"text":"every episode opens with random people on the street answering a tech question."},{"text":"in 1985 they asked people what a modem was."},{"text":"nobody knew."},{"text":"the show aired every answer."},{"text":"every single one."},{"text":"that's public television."},{"text":"computer chronicles."}]},{"id":"cc-024","slides":[{"text":"a portable computer in 1986 weighed 28 pounds."},{"text":"portable."},{"text":"computer chronicles."}]},{"id":"cc-025","slides":[{"text":"in 2000 a man sat on this set"},{"text":"and explained that his company was going to sell pet food on the internet."},{"text":"he had a domain name, venture capital, and a sock puppet."},{"text":"stewart cheifet nodded thoughtfully."},{"text":"the company was dead within a year."},{"text":"the sock puppet outlived the company."},{"text":"the nod outlived them both."},{"text":"computer chronicles."}]},{"id":"cc-026","slides":[{"text":"gary kildall died in 1994."},{"text":"the show ran for eight more years."},{"text":"it never found another co-host like him."},{"text":"it didn't try."},{"text":"computer chronicles."}]},{"id":"cc-027","slides":[{"text":"the laser printer episode is genuinely thrilling."},{"text":"we don't know what that says about us."},{"text":"computer chronicles."}]},{"id":"cc-028","slides":[{"text":"the show ended in 2002."},{"text":"the same year the dot-com bubble finished popping."},{"text":"it documented the entire arc"},{"text":"from wonder to wreckage"},{"text":"without ever changing its tone."},{"text":"computer chronicles."}]},{"id":"cc-029","slides":[{"text":"every guest brought a floppy disk."},{"text":"every guest."},{"text":"computer chronicles."}]},{"id":"cc-030","slides":[{"text":"they did a whole episode on fonts."},{"text":"the fonts episode is better than most movies."},{"text":"computer chronicles."}]},{"id":"cc-031","slides":[{"text":"in 1997 a guest predicted everyone would have a personal website within five years."},{"text":"he was right."},{"text":"then wrong."},{"text":"then right again."},{"text":"computer chronicles."}]},{"id":"cc-032","slides":[{"text":"the first episode aired on pbs in 1983."},{"text":"the internet wouldn't go public for another ten years."},{"text":"the show was already ready."},{"text":"computer chronicles."}]},{"id":"cc-033","slides":[{"text":"stewart cheifet interviewed people who built things that would outlive them"},{"text":"and people who built things that wouldn't survive the quarter."},{"text":"he gave them both the same amount of time."},{"text":"computer chronicles."}]},{"id":"cc-034","slides":[{"text":"a cd-rom could hold 650 megabytes."},{"text":"they said that number like it was the name of god."},{"text":"computer chronicles."}]},{"id":"cc-035","slides":[{"text":"the show ran from 1983 to 2002."},{"text":"it started before most people had a computer"},{"text":"and ended after most people had two."},{"text":"it covered every step in between."},{"text":"same host. same set. same thoughtful nod."},{"text":"nineteen years of the future arriving on a pbs budget."},{"text":"we're going to play every episode."},{"text":"computer chronicles."}]}],"audio":[{"filename":"boguscollective---1312.mp3","title":"1312","artist":"Boguscollective","url":"https://boguscollective.bandcamp.com/track/--1312","license":"by"},{"filename":"boguscollective---1310.mp3","title":"1310","artist":"Boguscollective","url":"https://boguscollective.bandcamp.com/track/--1310","license":"by"},{"filename":"boguscollective---1311.mp3","title":"1311","artist":"Boguscollective","url":"https://boguscollective.bandcamp.com/track/--1311","license":"by"},{"filename":"boguscollective---1314.mp3","title":"1314","artist":"Boguscollective","url":"https://boguscollective.bandcamp.com/track/--1314","license":"by"},{"filename":"boguscollective---1316.mp3","title":"1316","artist":"Boguscollective","url":"https://boguscollective.bandcamp.com/track/--1316","license":"by"},{"filename":"boguscollective---1317.mp3","title":"1317","artist":"Boguscollective","url":"https://boguscollective.bandcamp.com/track/--1317","license":"by"},{"filename":"boguscollective-birth-of-a-world.mp3","title":"Birth Of A World","artist":"Boguscollective","url":"https://boguscollective.bandcamp.com/track/birth-of-a-world","license":"by"},{"filename":"boguscollective-awakening-2.mp3","title":"Awakening 2","artist":"Boguscollective","url":"https://boguscollective.bandcamp.com/track/awakening-2","license":"by"},{"filename":"boguscollective-sight.mp3","title":"Sight","artist":"Boguscollective","url":"https://boguscollective.bandcamp.com/track/sight","license":"by"},{"filename":"boguscollective-shopping-center-a.mp3","title":"Shopping C